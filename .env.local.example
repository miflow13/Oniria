# OPTIONAL — leave these unset to use Oniria's zero-config local demo mode.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Server-side only. Required to read restricted Sanity content; also enables local draft preview.
# A read token is preferred for preview. The write token is also used by
# seed:library and can serve as the preview fallback.
# Never prefix either token with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=


# Optional shared secret for writing layout pins from a deployed
# library. Local `next dev` authoring works without this value. When set,
# open /map?layoutDebug=1&layoutKey=<this value>.
LIBRARY_LAYOUT_AUTHORING_KEY=

# Scheduled living-shelf updates (server-only).
CRON_SECRET=
LIBRARY_EVOLUTION_KEY=

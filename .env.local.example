# OPTIONAL — leave these unset to use Oniria's zero-config local demo mode.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Server-side only. Required for live Sanity draft preview in the DEV Library.
# A read token is preferred for preview. The write token is also used by
# seed:library and can serve as the preview fallback.
# Never prefix either token with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
